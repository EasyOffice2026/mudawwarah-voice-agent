# Server
PORT=4100
# Directory the conversation sessions are persisted in (JSON file). Leave empty to keep them in memory only.
DATA_DIR=./data

# Mdawra ordering API (the restaurant website backend)
MDAWRA_API_URL=https://mdawra-api.onrender.com/api
# Restaurant slug as configured in the Mdawra platform console
MDAWRA_TENANT=mdawra
# How long (seconds) the menu and settings are cached before being re-fetched
MENU_CACHE_SECONDS=120

# WhatsApp Cloud API (Meta)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SESSION_TTL_MINUTES=120
# WhatsApp catalogue (Meta Commerce Manager). When set, "menu" opens photos + cart; upload the menu with npm run catalog:sync
WHATSAPP_CATALOG_ID=
# Token with catalog_management for the upload (defaults to WHATSAPP_TOKEN)
WHATSAPP_CATALOG_TOKEN=
# WhatsApp Business Account ID and the published order form (npm run flow:sync prints the flow ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ORDER_FLOW_ID=

# OpenAI (speech-to-text, sales agent, text-to-speech)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Also answer voice notes with a spoken voice note (text is always sent)
VOICE_REPLIES=false
HISTORY_LIMIT=16

# Public base URL of this service (used for payment callback links)
PUBLIC_URL=https://mudawwarah-voice-agent.onrender.com
# Bearer token protecting GET /feedback
ADMIN_TOKEN=

# Payment link: none | mock | myfatoorah
PAYMENT_PROVIDER=none
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_CURRENCY=KWD

# Kitchen / after-sales
KITCHEN_WHATSAPP_NUMBER=
ORDER_POLL_SECONDS=30
PAYMENT_TIMEOUT_MINUTES=60
